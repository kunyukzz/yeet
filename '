void yeet_reset(void)
{
    // freeing list of source count
    for (int i = 0; i < g_yeet->sources.count; ++i)
    {
        free(g_yeet->sources.files[i]);
        g_yeet->sources.files[i] = NULL;
    }

    free(g_yeet);
    g_yeet = NULL;
}

